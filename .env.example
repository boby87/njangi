# Copiez ce fichier en `.env` à la racine (ignoré par Git) puis renseignez vos valeurs.

# Google Sign-In (OIDC) — Client ID Web généré dans Google Cloud Console
GOOGLE_WEB_CLIENT_ID=votre-client-id-web.apps.googleusercontent.com

# En développement local sans clé Google, mettez true ; dès que GOOGLE_WEB_CLIENT_ID est renseigné (et en prod), mettez false
NJANGI_SSO_ALLOW_DEV_FALLBACK=false

# Secret JWT HMAC-SHA256 (minimum 32 caractères — générez une valeur aléatoire forte en production)
# NJANGI_JWT_SECRET=remplacer-par-une-cle-secrete-aleatoire-de-64-caracteres
