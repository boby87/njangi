    {
      "name": "Phase 8 : Tour de Pot & Décaissement (ms-cotisations)",
      "item": [
        {
          "name": "8.1 - Planifier Tours de Pot",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.environment.set(\"potId\", jsonData.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenPresident}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionTontineId\": \"{{sessionId}}\",\n  \"groupeId\": \"{{groupeId}}\",\n  \"typeCotisationId\": \"{{typeCotisationPotId}}\",\n  \"montantPot\": 200000,\n  \"beneficiairesOrdonnes\": [\n    \"{{membrePresidentId}}\",\n    \"{{membreTresorierId}}\",\n    \"{{membreSecretaireId}}\",\n    \"{{membreCreatorId}}\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cotisations/pots/planifier",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cotisations", "pots", "planifier"]
            }
          }
        },
