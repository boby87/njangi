            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/paiements/{{paiementCashId}}/valider-cash",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "paiements", "{{paiementCashId}}", "valider-cash"]
