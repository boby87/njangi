              "raw": "{\n  \"reunionId\": \"{{reunionId}}\",\n  \"beneficiaireEffectifId\": \"{{membrePresidentId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cotisations/pots/{{potId}}/attribuer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cotisations", "pots", "{{potId}}", "attribuer"]
            }
          }
        },
        {
