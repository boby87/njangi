            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reunions/{{reunionId}}/quorum",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reunions", "{{reunionId}}", "quorum"]
            }
          }
        },
        {
          "name": "6.5 - Infliger Sanction Retard (2 000 XAF)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenPresident}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"membreId\": \"{{membreCreatorId}}\",\n  \"groupeId\": \"{{groupeId}}\",\n  \"sessionId\": \"{{sessionId}}\",\n  \"reunionId\": \"{{reunionId}}\",\n  \"typeInfraction\": \"RETARD_REUNION\",\n  \"montantManuel\": 2000,\n  \"motif\": \"Arrivée avec 25 minutes de retard en séance\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/penalites",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "penalites"]
            }
          }
        }
      ]
